# =============================================================================
# Sharetopus Environment Variables
# Copy this file to .env.local and fill in all required values.
# Every variable the code reads is listed here; docs/DEVELOPMENT.md groups
# them by service and says which are required.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk (Authentication)
# https://clerk.com - create an application and get keys from the dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Webhook signing secret (use the _DEV variant for local development)
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_WEBHOOK_SECRET_DEV=whsec_...

# -----------------------------------------------------------------------------
# Supabase (Database + Storage)
# https://supabase.com - project settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service role key: Supabase Storage only (src/actions/api/adminSupabase.ts). Server-only.
SUPABASE_SERVICE_ROLE=eyJ...

# Postgres connection strings (dashboard -> Connect). Server-only, never NEXT_PUBLIC_.
# Transaction pooler (port 6543): the app's Drizzle client (src/db/client.ts).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-your-region.pooler.supabase.com:6543/postgres
# Session pooler (port 5432): drizzle-kit, for `bun run db:pull | db:generate | db:migrate`.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-1-your-region.pooler.supabase.com:5432/postgres

# Encrypts social account tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Every environment that shares a database needs the same key. Losing it
# makes every stored token unreadable, so keep a copy in a secret store.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Optional: override the default storage bucket name (default: "scheduled-videos")
# SUPABASE_BUCKET_NAME=scheduled-videos

# Optional: custom domain for Supabase Storage (used by TikTok supabase_direct mode)
# SUPABASE_CUSTOM_STORAGE_DOMAIN=

# -----------------------------------------------------------------------------
# Stripe (Payments)
# https://stripe.com - developers -> API keys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret (use the _DEV variant for local development)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET_DEV=whsec_...

# -----------------------------------------------------------------------------
# Upstash (Redis rate limiting and the per-account token refresh lock)
# https://upstash.com - create a Redis database
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# -----------------------------------------------------------------------------
# LinkedIn OAuth
# https://developer.linkedin.com - create an app
# The same app also serves LinkedIn Pages (registry provider linkedin_page).
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=http://localhost:3000/api/social/linkedin/connect

# -----------------------------------------------------------------------------
# TikTok OAuth
# https://developers.tiktok.com - create an app
# Uses separate dev/prod credentials
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY_DEV=
TIKTOK_CLIENT_SECRET_DEV=
TIKTOK_REDIRECT_URL=http://localhost:3000/api/social/tiktok/connect

# Optional: TikTok media delivery mode. "proxy" (default) uses /api/media HMAC proxy.
# "supabase_direct" uses a custom Supabase Storage domain (requires SUPABASE_CUSTOM_STORAGE_DOMAIN).
# TIKTOK_MEDIA_SOURCE=proxy

# -----------------------------------------------------------------------------
# Pinterest OAuth
# https://developers.pinterest.com - create an app
# -----------------------------------------------------------------------------
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URL=http://localhost:3000/api/social/pinterest/connect

# -----------------------------------------------------------------------------
# Instagram OAuth
# https://developers.facebook.com - create a Meta app with Instagram Login
# -----------------------------------------------------------------------------
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URL=http://localhost:3000/api/social/instagram/connect

# -----------------------------------------------------------------------------
# YouTube OAuth (Google Cloud)
# https://console.cloud.google.com - create OAuth client, enable YouTube Data API v3
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URL=http://localhost:3000/api/social/youtube/connect

# -----------------------------------------------------------------------------
# X (Twitter) OAuth 2.0
# https://developer.x.com - create a project + app with OAuth 2.0 (confidential client)
# Scopes used: tweet.read tweet.write users.read media.write offline.access
# -----------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URL=http://localhost:3000/api/social/x/connect

# -----------------------------------------------------------------------------
# Facebook OAuth (Pages publishing)
# https://developers.facebook.com - create a Meta app with Facebook Login
# Scopes used: pages_show_list pages_manage_posts pages_read_engagement
# -----------------------------------------------------------------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:3000/api/social/facebook/connect

# -----------------------------------------------------------------------------
# Registry OAuth providers (src/lib/platforms/providers/catalog.ts)
# Each provider is available only when both of its variables are set.
# Redirect URI to register: <origin>/api/social/registry/<provider>/callback
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# x402 / REST OAuth redirect URIs
# Shared callback route for x402- and REST-initiated connections. Each must
# be registered in the platform's developer console.
# Format: <origin>/api/oauth/callback/<platform>
# -----------------------------------------------------------------------------
X402_LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/callback/linkedin
X402_TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/callback/tiktok
X402_PINTEREST_REDIRECT_URI=http://localhost:3000/api/oauth/callback/pinterest
X402_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/callback/instagram
X402_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/callback/youtube
X402_X_REDIRECT_URI=http://localhost:3000/api/oauth/callback/x
X402_FACEBOOK_REDIRECT_URI=http://localhost:3000/api/oauth/callback/facebook

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CRON_SECRET_KEY=your-secret-key-here

# Optional: override the base URL shown in MCP docs (defaults to https://sharetopus.com)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: browser-facing origin for share links and OAuth callback redirects
# (defaults to NEXT_PUBLIC_BASE_URL, then https://sharetopus.com)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: background job tuning, defaults in src/lib/jobs/runtimeConfig.ts
# (docs/INNGEST.md, Runtime configuration)
# MAX_DURATION_S=300
# MAX_FILE_MB=100
# POLL_WINDOW_S=120
# WORKER_MAX_RETRIES=3
# DISPATCHER_BATCH_SIZE=200
# SIGNED_URL_TTL_S=300

# -----------------------------------------------------------------------------
# Inngest (Background job processing)
# https://www.inngest.com - keys from the Inngest dashboard
# The SDK reads these automatically. Required for serve() endpoint auth
# and inngest.send() event dispatch.
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=signkey-prod-...

# -----------------------------------------------------------------------------
# Media Proxy Security
# HMAC secret for signing /api/media URLs. 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
MEDIA_PROXY_HMAC_SECRET=

# -----------------------------------------------------------------------------
# MCP Audit IP Hashing
# 32 random bytes (base64). Used to hash client IPs in mcp_audit_log so
# raw IPs never reach the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset in production, the IP hash helper falls back to a known-weak
# default and logs a warning per request.
# -----------------------------------------------------------------------------
MCP_IP_HASH_SALT=

# -----------------------------------------------------------------------------
# Coinbase CDP / x402 (Anonymous wallet access)
# https://portal.cdp.coinbase.com - create API key + Wallet Secret + Server Wallet account
# The CDP SDK reads CDP_API_KEY_ID, CDP_API_KEY_SECRET, CDP_WALLET_SECRET automatically.
# -----------------------------------------------------------------------------
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Server Wallet recipient addresses (created via the CDP dashboard or one-off script).
# These receive USDC payments from x402 wallets.
X402_RECIPIENT_EVM=
X402_RECIPIENT_SOLANA=

# Default network for x402 charges (mainnet only).
# Allowed values: base, polygon, arbitrum, celo, solana
X402_DEFAULT_NETWORK=base

# x402 facilitator URL (Coinbase-hosted, handles verify + settle + KYT).
# Default: https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Dedicated Solana JSON-RPC endpoint (https only) used for refund blockhash
# reads. Unset falls back to the public api.mainnet-beta.solana.com in
# networks.ts, which is rate-limited and can drop a refund read.
X402_SOLANA_RPC_URL=

# HMAC secret for the connection tokens the x402 connect and reauth flows
# issue (src/lib/x402/oauth/connectionToken.ts). Without it those flows refuse
# before charging. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
X402_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Celo x402 (settles through the Celo facilitator, not CDP)
# The Celo wallet is a plain EVM keypair held by the operator, never CDP.
# It receives payments (payTo) and sends refunds with the same key.
# -----------------------------------------------------------------------------
# payTo address on Celo (USDC payment recipient).
X402_RECIPIENT_CELO=
# Facilitator API key for settle (X-API-Key). Create it at https://x402.celo.org
# by connecting the payTo wallet; settlements consume prepaid credits.
X402_CELO_FACILITATOR_API_KEY=
# Private key of the Celo wallet (refund sender). 32-byte hex, 0x optional.
X402_CELO_REFUND_KEY=
# Optional: override the Celo facilitator API base URL.
# Default: https://api.x402.celo.org
# X402_CELO_FACILITATOR_URL=
# Optional: ERC-8021 attribution code (celo_...) appended to refund calldata.
# X402_CELO_ATTRIBUTION_TAG=

# -----------------------------------------------------------------------------
# Arc x402 (Sharetopus verifies and settles itself on Arc; no third party)
# -----------------------------------------------------------------------------
# Arc wallet that receives payments and signs settlements and refunds.
X402_RECIPIENT_ARC=
# Private key of X402_RECIPIENT_ARC. 32-byte hex, 0x optional.
X402_ARC_KEY=
# Optional: dedicated Arc RPC (https). Unset uses Arc's own public endpoint.
# X402_ARC_RPC_URL=
# Optional: opens POST /api/x402/facilitator/settle to its holder. Unset keeps
# settling closed to outside callers; /supported and /verify stay open.
# X402_FACILITATOR_SETTLE_KEY=
