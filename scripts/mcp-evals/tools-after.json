      },
      {
        "name": "get_account_analytics",
        "title": "Get Account Analytics",
        "description": "Daily views, likes, comments, shares and subscribers for your content, newest first. Data can be up to 24 h old.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "platform": {
              "description": "Platform id, e.g. youtube.",
              "type": "string",
              "maxLength": 32
            },
            "content_id": {
              "description": "A content_id from list_posts (published, detailed).",
              "type": "string",
              "maxLength": 200
            },
            "days": {
              "default": 30,
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "annotations": {
          "title": "Get Account Analytics",
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  },
                  "content_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "views": {
                    "type": "number"
                  },
                  "likes": {
                    "type": "number"
                  },
                  "comments": {
                    "type": "number"
                  },
                  "shares": {
                    "type": "number"
                  },
                  "subscribers": {
                    "type": "number"
                  }
                },
                "required": [
                  "date",
                  "platform",
                  "content_id",
                  "views",
                  "likes",
                  "comments",
                  "shares",
                  "subscribers"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "metrics"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "attach_media_from_url",
        "title": "Attach Media From URL",
        "description": "Copy an image or video from a public URL into storage (JPEG, PNG, GIF, WebP, MP4, MOV, WebM; no redirects). Returns storage_path to pass as media_storage_path in publish_posts.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Public http(s) URL of the file."
            }
          },
          "required": [
            "url"
          ]
        },
        "annotations": {
          "title": "Attach Media From URL",
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "storage_path": {
              "type": "string"
            },
            "content_type": {
              "type": "string"
            },
            "size_bytes": {
              "type": "number"
            }
          },
          "required": [
            "storage_path",
            "content_type",
            "size_bytes"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "request_upload_url",
        "title": "Request Upload URL",
        "description": "Get a signed URL to upload a local image or video yourself: PUT the bytes to upload_url with the file's Content-Type, then pass storage_path as media_storage_path in publish_posts.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1,
              "description": "With extension, e.g. clip.mp4."
            },
            "content_type": {
              "type": "string",
              "minLength": 1,
              "description": "image/jpeg, image/png, video/mp4, video/mov or video/quicktime."
            },
            "size_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "filename",
            "content_type",
            "size_bytes"
          ]
        },
        "annotations": {
          "title": "Request Upload URL",
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "upload_url": {
              "type": "string"
            },
            "storage_path": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "expires_in_seconds": {
              "type": "number"
            }
          },
          "required": [
            "upload_url",
            "storage_path",
            "token",
            "expires_in_seconds"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "publish_posts",
        "title": "Publish Posts",
        "description": "Publish or schedule 1 to 30 posts. A post with scheduled_at is scheduled; one without it is published now. To cross-post, add one entry per account with the same media_storage_path. Check the outcome with list_posts and the returned batch_id.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "posts": {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "social_account_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
                    "description": "Account id from list_connections. The platform follows from the account."
                  },
                  "post_type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "video"
                    ],
                    "description": "The platform must accept this type."
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Caption or body text. Required for text posts."
                  },
                  "title": {
                    "description": "Required on reddit, lemmy, devto, hashnode, medium, wordpress and dribbble. Pinterest and YouTube use it too.",
                    "type": "string"
                  },
                  "media_storage_path": {
                    "default": "",
                    "description": "From attach_media_from_url or request_upload_url. Required for image and video.",
                    "type": "string"
                  },
                  "scheduled_at": {
                    "description": "Future ISO 8601 time with a zone (Z or +02:00) to schedule the post. Omit to publish now.",
                    "type": "string"
                  },
                  "cover_timestamp": {
                    "description": "TikTok video cover frame in ms (at least 1000).",
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 9007199254740991
                  },
                  "pinterest_board_id": {
                    "description": "Required for Pinterest. From list_pinterest_boards.",
                    "type": "string"
                  },
                  "pinterest_link": {
                    "description": "Pinterest: where the pin links to.",
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "subreddit": {
                    "description": "Reddit: subreddit to post to. Required when platform is reddit.",
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 50
                  },
                  "flair_id": {
                    "description": "Reddit: flair id for the post.",
                    "type": "string",
                    "maxLength": 100
                  },
                  "community_id": {
                    "description": "Lemmy: community id. Required when platform is lemmy.",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "publication_id": {
                    "description": "Hashnode: publication id. Defaults to the account's first publication.",
                    "type": "string",
                    "maxLength": 100
                  },
                  "blog": {
                    "description": "Tumblr: blog name. Defaults to the blog stored when the account connected.",
                    "type": "string",
                    "maxLength": 100
                  },
                  "location_name": {
                    "description": "Google Business Profile: location, shaped \"locations/<id>\". Required when platform is gmb.",
                    "type": "string",
                    "pattern": "^locations\\/[0-9]+$"
                  },
                  "organization_id": {
                    "description": "LinkedIn Pages: organization id. Defaults to the connected organization.",
                    "type": "string",
                    "maxLength": 50
                  },
                  "canonical_url": {
                    "description": "dev.to: canonical URL of the original article.",
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "tags": {
                    "description": "dev.to: up to 4 tags.",
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    }
                  }
                },
                "required": [
                  "social_account_id",
                  "post_type",
                  "description"
                ]
              }
            },
            "batch_id": {
              "description": "Reuse the same batch_id when retrying: posts it already created are not duplicated.",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "posts"
          ]
        },
        "annotations": {
          "title": "Publish Posts",
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "batch_id": {
              "type": "string"
            },
            "publishing_now": {
              "type": "number"
            },
            "scheduled": {
              "type": "number"
            },
            "duplicates": {
              "type": "number"
            },
            "rejected": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "social_account_id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "social_account_id",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "event_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "schedule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "batch_id",
            "publishing_now",
            "scheduled",
            "duplicates",
            "rejected",
            "event_ids",
            "schedule_ids",
            "message"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "update_scheduled_posts",
        "title": "Update Scheduled Posts",
        "description": "Change up to 50 scheduled posts. cancel: stops posts in status scheduled. resume: brings cancelled posts back (a past time moves to 1 hour from now). reschedule: sets a new future time and resumes cancelled posts. Get post ids from list_posts.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "post_ids": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
