{
  "initialize": {
    "protocolVersion": "2025-11-25",
    "capabilities": {
      "tools": {
        "listChanged": false
      }
    },
    "serverInfo": {
      "name": "Sharetopus",
      "version": "eval"
    },
    "instructions": "Sharetopus publishes and schedules posts on the user's connected social accounts.\n\nPosting takes two calls:\n1. list_connections: take each account's id (its platform and status come with it).\n2. publish_posts: one entry per account. Add scheduled_at (a future ISO 8601 time with a zone, e.g. 2026-10-08T10:00:00Z) to schedule a post; leave it out to publish now.\nThen list_posts with the returned batch_id shows what happened to each post.\n\nMedia: attach_media_from_url copies a public image or video; request_upload_url gives a signed URL to PUT a local file. Both return storage_path, which is publish_posts' media_storage_path. One path can serve several posts.\nTargets: Pinterest needs pinterest_board_id (from list_pinterest_boards); reddit needs subreddit, lemmy community_id, gmb location_name; reddit, lemmy, devto, hashnode, medium, wordpress and dribbble need a title.\nAn account in needs_reconnect status cannot publish until the user reconnects it at reconnect_url.\nupdate_scheduled_posts cancels, resumes or reschedules scheduled posts; delete_scheduled_posts removes them for good.\nTikTok posts made through this server are public.\nLimits: 30 posts per publish_posts call; list_billing_summary shows the monthly quotas."
  },
  "tools": {
    "tools": [
      {
        "name": "list_connections",
        "title": "List Connections",
        "description": "List the connected social accounts with their id, platform and status. Use an id as social_account_id in publish_posts. An account in needs_reconnect status cannot publish until the user reconnects it at reconnect_url.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "response_format": {
              "default": "concise",
              "description": "detailed adds follower_count and avatar_url.",
              "type": "string",
              "enum": [
                "concise",
                "detailed"
              ]
            }
          }
        },
        "annotations": {
          "title": "List Connections",
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "accounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  },
                  "name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "username": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "needs_reconnect"
                    ]
                  },
                  "follower_count": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "avatar_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "platform",
                  "name",
                  "username",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "reconnect_url": {
              "type": "string"
            }
          },
          "required": [
            "accounts",
            "reconnect_url"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_pinterest_boards",
        "title": "List Pinterest Boards",
        "description": "List the boards of a connected Pinterest account. A Pinterest post needs one board id as pinterest_board_id. Pass the returned bookmark to get the next page.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "social_account_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
              "description": "A Pinterest account id from list_connections."
            },
            "page_size": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "bookmark": {
              "type": "string"
            }
          },
          "required": [
            "social_account_id"
          ]
        },
        "annotations": {
          "title": "List Pinterest Boards",
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "boards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "privacy": {
                    "type": "string"
                  },
                  "pin_count": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "bookmark": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "boards",
            "bookmark"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_posts",
        "title": "List Posts",
        "description": "List posts: upcoming (scheduled, oldest first), published, failed or cancelled (newest first). Pass batch_id from publish_posts to see what happened to each post of that call.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "status": {
              "default": "upcoming",
              "type": "string",
              "enum": [
                "upcoming",
                "published",
                "failed",
                "cancelled"
              ]
            },
            "batch_id": {
              "description": "Overrides status: returns every post of that batch.",
              "type": "string",
              "maxLength": 200
            },
            "social_account_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
            },
            "platform": {
              "description": "Platform id, e.g. linkedin.",
              "type": "string",
              "maxLength": 32
            },
            "from": {
              "description": "ISO 8601 lower time bound.",
              "type": "string"
            },
            "to": {
              "description": "ISO 8601 upper time bound.",
              "type": "string"
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "response_format": {
              "default": "concise",
              "description": "detailed adds full text, title, account id, content id and media URL.",
              "type": "string",
              "enum": [
                "concise",
                "detailed"
              ]
            }
          }
        },
        "annotations": {
          "title": "List Posts",
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "posts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  },
                  "account": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "time": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "text": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "media_type": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "batch_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "error": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "social_account_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "content_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "media_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "status",
                  "platform",
                  "account",
                  "time",
                  "text",
                  "media_type",
                  "batch_id"
                ],
                "additionalProperties": false
              }
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "posts",
            "has_more",
            "next_offset"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_billing_summary",
